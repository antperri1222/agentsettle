# Local simulator is fully offline and requires no secrets.
PORT=3000

# Data source for the dashboard's On-chain tab: anvil | base-sepolia
# (anvil is auto-detected after `npm run chain:up`)
# AGENTSETTLE_NETWORK=anvil
# ANVIL_PORT=8545

# Base Sepolia (testnet only). Values verified 2026-11-03; re-verify before use (docs/RUNBOOK.md).
# BASE_SEPOLIA_RPC_URL=https://your-provider-rpc   # public https://sepolia.base.org is rate-limited
# USDC is pinned in sdk/networks.ts: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
# ESCROW_ADDRESS=      # set only after an authorized deployment
# ESCROW_DEPLOY_BLOCK=
# OWNER_ADDRESS= BUYER_AGENT_ADDRESS= PROVIDER_AGENT_ADDRESS=   # display labels only; authorize nothing
# TREASURY_ADDRESS= ARBITER_ADDRESS=                            # deploy-time roles

# Never put private keys or seed phrases here or in prompts. Use `cast wallet import` keystores.
