{
  "name": "agentsettle-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AgentSettle local agent-to-agent escrow simulator and prototype Solidity contracts",
  "scripts": {
    "dev": "node --env-file-if-exists=.env demo/server.mjs",
    "test": "node --test demo/test/*.test.mjs test/unit/*.test.ts",
    "test:contracts": "cd contracts && forge test",
    "test:e2e": "node --test test/e2e/*.test.ts",
    "test:all": "npm run typecheck && npm test && npm run test:contracts && npm run test:e2e",
    "typecheck": "tsc -p .",
    "build:contracts": "cd contracts && forge build && cd .. && node scripts/gen-artifacts.mjs",
    "setup:contracts": "sh scripts/install-contract-deps.sh",
    "chain:up": "node scripts/chain-up.ts",
    "agents:demo": "node scripts/agents-demo.ts",
    "agents:sepolia": "node --env-file-if-exists=.env scripts/agents-sepolia.ts",
    "mcp": "node mcp/server.ts",
    "mcp:setup": "node --env-file-if-exists=.env scripts/mcp-setup.ts",
    "owner": "node --env-file-if-exists=.env scripts/owner.ts",
    "mcp:install-desktop": "node --env-file-if-exists=.env scripts/install-claude-desktop.mjs",
    "relay": "node relay/server.ts",
    "join": "node scripts/join.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "viem": "^2.57.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
